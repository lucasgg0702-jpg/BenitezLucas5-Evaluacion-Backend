{{> breadcrumb}}
<div class="container">
    <div class="row">
        <p class="text-end">Hola {{persona}}! <a class="btn btn-danger" href="/admin/login/logout">Cerrar Sesión <i class="fa fa-sign-out-alt"></i></a></p>
    </div>
    <div class="row">
        <div class="col-7">
            <h3>Habitaciones — {{hospedaje.nombre}}</h3>
        </div>
        <div class="col-5 text-end">
            <a class="btn btn-success" href="/admin/hospedajes/{{hospedaje.id}}/habitaciones/agregar"><i class="fa fa-plus" aria-hidden="true"></i>Nueva</a>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <table class="table">
                <thead>
                    <tr class="table-dark">
                        <th scope="col">#</th>
                        <th scope="col">Número</th>
                        <th scope="col">Capacidad</th>
                        <th scope="col">Precio</th>
                        <th scope="col">Imagen</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each habitaciones}}
                    <tr>
                        <th scope="row">{{id}}</th>
                        <td>{{numero}}</td>
                        <td>{{capacidad}}</td>
                        <td>${{precio}}</td>
                        <td>{{{imagen}}}</td>
                        <td class="text-end">
                            <a class="btn btn-secondary" href="/admin/hospedajes/{{../hospedaje.id}}/habitaciones/modificar/{{id}}"><i class="fa fa-pencil" aria-hidden="true"></i></a>
                            <a class="btn btn-secondary" href="/admin/hospedajes/{{../hospedaje.id}}/habitaciones/eliminar/{{id}}"><i class="fa fa-trash" aria-hidden="true"></i></a>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</div>