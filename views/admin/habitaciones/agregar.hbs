{{> breadcrumb}}
<div class="login">
    <div class="login-triangle"></div>
    <h2 class="login-header">Agregar Habitación — {{hospedaje.nombre}}</h2>
    <form action="/admin/hospedajes/{{hospedaje.id}}/habitaciones/agregar" method="post" enctype="multipart/form-data" class="login-container">
        <p><input type="text" class="form-control" placeholder="Número/Nombre (ej: Habitación 1 Simple)" name="numero"></p>
        <p><input type="number" class="form-control" placeholder="Capacidad (personas)" name="capacidad"></p>
        <p><input type="number" step="0.01" class="form-control" placeholder="Precio por noche" name="precio"></p>
        <p><textarea class="form-control" placeholder="Comodidades" name="comodidades"></textarea></p>
        <p><input type="number" class="form-control" placeholder="Orden (opcional)" name="orden"></p>
        <p><label>Imagen: <input type="file" name="imagen" id="imagen"></label></p>
        <p><input type="submit" value="Guardar"></p>
    </form>
    {{#if error}}<p>{{message}}</p>{{/if}}
</div>