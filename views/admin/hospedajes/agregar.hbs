{{> breadcrumb}}
<div class="login">
    <div class="login-triangle"></div>

    <h2 class="login-header">Agregar Hospedaje</h2>

    <form action="/admin/hospedajes/agregar" method="post" enctype="multipart/form-data" class="login-container">
        <p><input type="text" class="form-control" placeholder="Nombre" name="nombre"></p>
        <p><input type="text" class="form-control" placeholder="Slug (ej: hotel-alto-uruguay)" name="slug"></p>
        <p><textarea class="form-control" placeholder="Descripción" name="descripcion"></textarea></p>
        <p><input type="text" class="form-control" placeholder="Tipo (ej: Hotel)" name="tipo"></p>
        <p><input type="text" class="form-control" placeholder="Horario de ingreso" name="horario_ingreso"></p>
        <p><input type="text" class="form-control" placeholder="Dirección" name="direccion"></p>
        <p><input type="text" class="form-control" placeholder="Teléfono" name="telefono"></p>
        <p><input type="number" class="form-control" placeholder="Capacidad máxima" name="capacidad_max"></p>
        <p><input type="number" step="0.01" class="form-control" placeholder="Precio base" name="precio_base"></p>
        <p><input type="text" class="form-control" placeholder="Tags (separados por coma)" name="tags"></p>
        <p><input type="text" class="form-control" placeholder="Link de Google Maps" name="mapa_url"></p>
        <p><label for="">Imagen: <input type="file" name="imagen" id="imagen"></label></p>
        <p><input type="submit" value="Guardar"></p>
    </form>
    {{#if error}}
    <p>{{message}}</p>
    {{/if}}
</div>