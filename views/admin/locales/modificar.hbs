{{> breadcrumb}}
<div class="login">
    <div class="login-triangle"></div>

    <h2 class="login-header">Modificar Local</h2>

    <form action="/admin/locales/modificar" method="post" enctype="multipart/form-data" class="login-container">
        <input type="hidden" value="{{local.id}}" name="id">

        <label for="">Nombre</label>
        <p><input type="text" class="form-control" name="nombre" value="{{local.nombre}}"></p>

        <label for="">Slug</label>
        <p><input type="text" class="form-control" name="slug" value="{{local.slug}}"></p>

        <label for="">Descripción</label>
        <p><textarea class="form-control" name="descripcion">{{local.descripcion}}</textarea></p>

        <label for="">Dirección</label>
        <p><input type="text" class="form-control" name="direccion" value="{{local.direccion}}"></p>

        <label for="">Teléfono</label>
        <p><input type="text" class="form-control" name="telefono" value="{{local.telefono}}"></p>

        <label for="">Horario</label>
        <p><input type="text" class="form-control" name="horario" value="{{local.horario}}"></p>

        <label for="">Tags</label>
        <p><input type="text" class="form-control" name="tags" value="{{local.tags}}"></p>

        <label for="">Link de Google Maps</label>
        <p><input type="text" class="form-control" name="mapa_url" value="{{local.mapa_url}}"></p>

        <label for="">Precio delivery (vacío = sin delivery)</label>
        <p><input type="number" step="0.01" class="form-control" name="delivery_precio" value="{{local.delivery_precio}}"></p>

        <label>Imagen:</label>
        <p><input type="file" name="imagen" id="imagen"></p>

        <p><label>
                Eliminar imagen actual?
                <input type="checkbox" name="img_delete" id="img_delete" value="1">
        </label></p>

        <input type="hidden" name="img_original" value="{{local.img_id}}">

        <p><input type="submit" value="Modificar"></p>
    </form>

    {{#if error}}
    <p>{{message}}</p>
    {{/if}}
</div>